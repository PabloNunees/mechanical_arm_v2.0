#include <Arduino.h>
#include <SPI.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <Fonts/FreeSerif12pt7b.h>

Adafruit_SSD1306 display(-1);

const int botao_movimen = 4;
const int botao_garra   = 3;
int contador = 0;

int base_horizo = 0;  // A0
int base_verti  = 0;  // A1
int cotovelo    = 0;  // A2
int mao_vertical    = 0;  // A3
int mao_horizo      = 0;  // A4
int garra       = 0;  // A5

void setup() {
  Serial.begin(9600);
  pinMode(botao_movimen, INPUT);
  pinMode(botao_garra,   INPUT);
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);

  base_horizo   = analogRead(A0);
  base_verti    = analogRead(A7);
  cotovelo      = analogRead(A6);
  mao_vertical  = analogRead(A3);
  mao_horizo    = analogRead(A4);
  garra         = analogRead(A5);
}

void loop() {
  Serial.println(base_horizo);

  base_horizo   = analogRead(A0);
  base_verti    = analogRead(A7);
  cotovelo      = analogRead(A6);
  mao_vertical  = analogRead(A3);
  mao_horizo    = analogRead(A6);
  garra         = analogRead(A7);

  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(WHITE);

  if (digitalRead(botao_movimen) == HIGH) {
    if (contador == 0) {
      contador = 1;
    } else {
      contador = 0;
    }
    delay(200);
  }

  if (contador == 0) {
    display.setCursor(0, 4);
    display.println("> modo livre");
    display.setCursor(0, 22);
    display.println("  automatico");
    if (digitalRead(botao_garra) == HIGH){
      modolivre();
    }
  }
  else if (contador == 1) {
    display.setCursor(0, 4);
    display.println("  modo livre");
    display.setCursor(0, 22);
    display.println("> automatico");
  }
  display.display();
}

void modolivre() {
  while (true) {
    base_horizo   = analogRead(A0);
    base_verti    = analogRead(A7);
    cotovelo      = analogRead(A6);
    mao_vertical  = analogRead(A3);
    mao_horizo    = analogRead(A4);
    garra         = analogRead(A5);

    if (base_horizo > 0) {
      Serial.print("base,"); Serial.println(base_horizo);
    }
    else if (base_verti > 0) {
      Serial.print("base2,"); Serial.println(base_verti);
    }
    else if (cotovelo > 0) {
      Serial.print("3,"); Serial.println(cotovelo);
    }
    else if (mao_vertical > 0) {
      Serial.print("4,"); Serial.println(mao_vertical);
    }
    else if (mao_horizo > 0) {
      Serial.print("5,"); Serial.println(mao_horizo);
    }
    else if (garra > 0) {
      Serial.print("6,"); Serial.println(garra);
    }

    delay(20);

    if (digitalRead(botao_movimen) == HIGH) {
      delay(200);
      if (digitalRead(botao_movimen) == HIGH) {
        break;
      }
    }
  }
}
